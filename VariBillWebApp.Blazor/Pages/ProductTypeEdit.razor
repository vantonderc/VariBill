@page "/producttype/edit/{Id:guid}"
@using VariBillWebApp.Blazor.Models.DTOs
@using VariBillWebApp.Blazor.Models.ViewModels
@using VariBillWebApp.Blazor.Services.Abstractions
@inject IProductTypeService ProductTypeService
@inject NavigationManager Navigation

<h3>Edit Product Type</h3>

@if (type == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText @bind-Value="model.Name" class="form-control" />
            <ValidationMessage For="@(() => model.Name)" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea @bind-Value="model.Description" class="form-control" />
        </div>

        <AuthorizeView Policy="RequireAdminRole">
            <Authorized Context="auth">
                <button type="submit" class="btn btn-primary">Update</button>
            </Authorized>
            <NotAuthorized Context="auth">
                <div class="alert alert-warning">You do not have permission to update product types.</div>
            </NotAuthorized>
        </AuthorizeView>
        <a href="/producttypes" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProductTypeApiResponseDto? type;
    private ProductTypeFormViewModel model = new();

    protected override async Task OnInitializedAsync()
    {
        type = await ProductTypeService.GetProductTypeByIdAsync(Id);
        if (type != null)
        {
            model.Name = type.Name;
            model.Description = type.Description;
        }
    }

    private async Task HandleValidSubmit()
    {
        var dto = new UpdateProductTypeDto(model.Name!, model.Description);
        var success = await ProductTypeService.UpdateProductTypeAsync(Id, dto);
        if (success)
        {
            var uri = $"/producttypes?status=success&message={Uri.EscapeDataString("Product type updated.")}";
            Navigation.NavigateTo(uri);
        }
    }
}
