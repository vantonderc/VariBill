@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-4">
    <div class="jumbotron">
        <h1 class="display-4">Welcome to VariBill</h1>
        <p class="lead">Product Management System</p>
        <hr class="my-4">
        <p>Manage your products and product types efficiently.</p>
        <a class="btn btn-primary btn-lg" href="/products" role="button">View Products</a>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Products</h5>
                    <p class="card-text">Create, view, update, and delete products.</p>
                    <a href="/products" class="btn btn-primary">Manage Products</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Product Types</h5>
                    <p class="card-text">Manage product categories and types.</p>
                    <a href="/producttypes" class="btn btn-primary">Manage Product Types</a>
                </div>
            </div>
        </div>
    </div>
</div>
