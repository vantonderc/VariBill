@page "/producttype/create"
@using VariBillWebApp.Blazor.Models.DTOs
@using VariBillWebApp.Blazor.Models.ViewModels
@using VariBillWebApp.Blazor.Services.Abstractions
@inject IProductTypeService ProductTypeService
@inject NavigationManager Navigation

<h3>Create Product Type</h3>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText @bind-Value="model.Name" class="form-control" />
        <ValidationMessage For="@(() => model.Name)" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea @bind-Value="model.Description" class="form-control" />
    </div>

    <AuthorizeView Policy="RequireAdminRole">
        <Authorized Context="auth">
            <button type="submit" class="btn btn-primary">Save</button>
        </Authorized>
        <NotAuthorized Context="auth">
            <div class="alert alert-warning">You do not have permission to create product types.</div>
        </NotAuthorized>
    </AuthorizeView>
    <a href="/producttypes" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private ProductTypeFormViewModel model = new();

    private async Task HandleValidSubmit()
    {
        var dto = new CreateProductTypeDto(model.Name!, model.Description);
        var created = await ProductTypeService.CreateProductTypeAsync(dto);
        if (created != null)
        {
            var uri = $"/producttypes?status=success&message={Uri.EscapeDataString("Product type created.")}";
            Navigation.NavigateTo(uri);
        }
        else
        {
            // show a simple message inline
        }
    }
}
