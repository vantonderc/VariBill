@page "/products"
@using VariBillWebApp.Blazor.Models.DTOs
@using VariBillWebApp.Blazor.Services.Abstractions
@inject IProductService ProductService
@inject NavigationManager Navigation
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Products</h3>
    <a href="/product/create" class="btn btn-primary">Create New</a>
</div>

@if (products == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!products.Any())
{
    <div class="card text-center py-4">
        <div class="card-body muted">No products found. Click "Create New" to add one.</div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td class="muted">@p.SKU</td>
                        <td>@p.Price.ToString("C")</td>
                        <td>@p.Quantity</td>
                        <td><span class="badge bg-info text-dark">@p.ProductTypeName</span></td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a href="/product/details/@p.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <AuthorizeView Policy="RequireAdminRole">
                                    <Authorized>
                                        <a href="/product/edit/@p.Id" class="btn btn-sm btn-warning">Edit</a>
                                        <a href="/product/delete/@p.Id" class="btn btn-sm btn-danger">Delete</a>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductApiResponseDto>? products;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await ProductService.GetAllProductsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Products.razor: failed to load products: {ex}");
            products = new List<ProductApiResponseDto>();
        }
    }
}