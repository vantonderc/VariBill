@page "/products"
@using VariBillWebApp.Blazor.Models.DTOs
@using VariBillWebApp.Blazor.Services.Abstractions
@inject IProductService ProductService
@inject NavigationManager Navigation

<h3>Products</h3>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.SKU</td>
                        <td>@p.Price.ToString("C")</td>
                        <td>@p.Quantity</td>
                        <td><span class="badge bg-info">@p.ProductTypeName</span></td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <AuthorizeView Policy="RequireAdminRole">
                                <Authorized>
                                    <a href="/product/edit/@p.Id" class="btn btn-sm btn-warning">Edit</a>
                                    <a href="/product/delete/@p.Id" class="btn btn-sm btn-danger">Delete</a>
                                </Authorized>
                            </AuthorizeView>
                            <a href="/product/details/@p.Id" class="btn btn-sm btn-info">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a href="/product/create" class="btn btn-primary">Create New</a>
}

@code {
    private List<ProductApiResponseDto>? products;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await ProductService.GetAllProductsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Products.razor: failed to load products: {ex}");
            products = new List<ProductApiResponseDto>();
        }
    }
}