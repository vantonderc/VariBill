@page "/product/details/{Id:guid}"
@using VariBillWebApp.Blazor.Models.DTOs
@using VariBillWebApp.Blazor.Services.Abstractions
@inject IProductService ProductService
@inject NavigationManager Navigation

<h3>Product Details</h3>

@if (product == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@product.Name</dd>

        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9">@product.SKU</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@product.Price.ToString("C")</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@product.Quantity</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@product.ProductTypeName</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                @(product.IsActive ? "Active" : "Inactive")
            </span>
        </dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@product.Description</dd>
    </dl>
    <a href="/products" class="btn btn-secondary">Back</a>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProductApiResponseDto? product;

    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductByIdAsync(Id);
    }
}