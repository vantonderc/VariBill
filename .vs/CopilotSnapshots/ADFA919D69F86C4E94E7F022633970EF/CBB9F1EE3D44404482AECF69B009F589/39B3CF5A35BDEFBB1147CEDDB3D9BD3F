@page "/producttypes"
@using VariBillWebApp.Blazor.Models.DTOs
@using VariBillWebApp.Blazor.Services.Abstractions
@inject IProductTypeService ProductTypeService
@inject NavigationManager Navigation

<h3>Product Types</h3>

@if (types == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Product Count</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in types)
                {
                    <tr>
                        <td><strong>@t.Name</strong></td>
                        <td>@t.Description</td>
                        <td><span class="badge bg-info">@t.ProductCount</span></td>
                        <td>
                            <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                @(t.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a href="/producttype/edit/@t.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/producttype/delete/@t.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a href="/producttype/create" class="btn btn-primary">Create New Type</a>
}

@code {
    private List<ProductTypeApiResponseDto>? types;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            types = await ProductTypeService.GetAllProductTypesAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"ProductTypes.razor: failed to load types: {ex}");
            types = new List<ProductTypeApiResponseDto>();
        }
    }
}
