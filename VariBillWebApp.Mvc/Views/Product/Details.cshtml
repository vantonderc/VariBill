@using VariBillWebApp.Mvc.Models.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Product Details";
    ViewData["PageTitle"] = "Product Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow">
            <div class="card-header bg-info text-white"><h4 class="mb-0"><i class="fas fa-info-circle"></i> Product Details</h4></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4">SKU</dt>
                    <dd class="col-sm-8">@Model.SKU</dd>
                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
                    <dt class="col-sm-4">Quantity</dt>
                    <dd class="col-sm-8">@Model.Quantity</dd>
                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">@Model.ProductTypeName</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    }
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                    @if (Model.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-4">Last Modified</dt>
                        <dd class="col-sm-8">@Model.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                </dl>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="fas fa-trash"></i> Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>




